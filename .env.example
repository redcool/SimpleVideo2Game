# 本机配置示例。没有自动加载：把需要的项设成环境变量（PowerShell 里 $env:NAME="..."）。
# 复制成 .env 只当备忘，.env 已在 .gitignore 里。

# ComfyUI 服务地址（comfy_client / comfy_asset / comfy_health 都读它）
COMFY_URL=http://127.0.0.1:8188

# ComfyUI 的安装目录（模型、input/、output/ 都在里面；本机约 360 GB，绝不入库）
# comfy_asset.py --upload 用它把参考图送进 input/
COMFY_HOME=

# 或者直接指到 input 目录（优先级高于 COMFY_HOME）
COMFY_INPUT=

# 动作产线（UniMate 文本→动作 / GVHMR 视频动补）所在工程
AIGEN_ANIM_PRJ=../motionPrj/AIGenAnimPrj

# 录屏用的 Chrome（留空则自动在常见安装位置找）
CHROME_PATH=