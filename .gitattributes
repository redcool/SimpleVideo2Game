# Keep line endings consistent across Windows / macOS / Linux checkouts.
* text=auto eol=lf

# Binary media must never be normalised.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.mp4 binary
*.webm binary
*.mov binary
*.mp3 binary
*.wav binary
*.glb binary
*.glb.zst binary
*.fbx binary
*.blend binary
*.zip binary

# ComfyUI workflows are JSON: keep them diff-friendly and LF.
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.mjs text eol=lf
*.ps1 text eol=crlf
